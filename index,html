<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XI IPS 1 - Class Portal</title>
    <link href="assets/images/logo.svg" rel="icon" type="image/svg+xml">
    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <div class="background">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="grid"></div>
    </div>

    <!-- NAVBAR -->
    <header class="navbar">
        <div class="logo">
            <div class="logo-icon">XI</div>
            <div>
                <strong>XI IPS 1</strong>
                <small>Class Portal</small>
            </div>
        </div>

        <nav>
            <a href="#home">Home</a>
            <a href="#students">Siswa</a>
            <a href="#schedule">Jadwal</a>
            <a href="#moments">Class Moments</a>
            <a href="#spotify">Music</a>
            <a href="group.html">Spin Kelompok</a>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <main>

        <!-- HERO SECTION -->
        <section id="home" class="hero">
            <div class="hero-content">
                <span class="badge">● CLASS PORTAL</span>
                <h1>
                    Welcome to
                    <span>XI IPS 1</span>
                </h1>
                <p>
                    Portal digital kelas untuk informasi siswa,
                    jadwal pelajaran, dokumentasi kelas, musik,
                    dan berbagai fitur interaktif.
                </p>
                <div style="display: flex; gap: 12px; margin-top: 20px;">
                    <a href="#students" class="btn primary">Lihat Siswa</a>
                    <a href="group.html" class="btn" style="background: rgba(255,255,255,0.1); color: white; padding: 10px 20px; border-radius: 8px; text-decoration: none;">Spin Kelompok</a>
                </div>
            </div>

            <div class="hero-card">
                <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                    <span>XI IPS 1</span>
                    <span style="color: #22c55e;">● ONLINE</span>
                </div>
                <div class="hero-number" style="font-size: 48px; font-weight: bold; margin-bottom: 5px;">27</div>
                <p style="color: #888; margin-bottom: 20px;">Jumlah Siswa</p>

                <div style="display: flex; justify-content: space-between; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 15px;">
                    <div>
                        <strong>2026</strong>
                        <small style="display: block; color: #888;">Tahun Ajaran</small>
                    </div>
                    <div>
                        <strong>XI</strong>
                        <small style="display: block; color: #888;">Kelas</small>
                    </div>
                </div>
            </div>
        </section>

        <!-- NEXT CLASS SECTION -->
        <section style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.03); padding: 20px; border-radius: 12px; margin-bottom: 30px;">
            <div>
                <span style="color: var(--primary, #6366f1); font-size: 12px; font-weight: bold;">NEXT CLASS</span>
                <h2 style="font-size: 18px; margin: 5px 0;">Memuat Jadwal...</h2>
                <p style="color: #888; font-size: 14px; margin: 0;">--:--</p>
            </div>
            <div>
                <span style="font-family: monospace; font-size: 20px; font-weight: bold;">00:00:00</span>
            </div>
        </section>

        <!-- STUDENTS SECTION -->
        <section id="students" style="margin-bottom: 40px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div>
                    <span style="color: var(--primary, #6366f1); font-size: 12px; font-weight: bold;">CLASS MEMBERS</span>
                    <h2>Daftar Siswa</h2>
                </div>
                <span style="background: rgba(255,255,255,0.08); padding: 5px 12px; border-radius: 20px; font-size: 14px;">27 Siswa</span>
            </div>
            <div id="studentsGrid"></div>
        </section>

        <!-- SCHEDULE SECTION -->
        <section id="schedule" style="margin-bottom: 40px;">
            <div style="margin-bottom: 20px;">
                <span style="color: var(--primary, #6366f1); font-size: 12px; font-weight: bold;">CLASS SCHEDULE</span>
                <h2>Jadwal Pelajaran</h2>
            </div>
            <div id="scheduleContainer"></div>
        </section>

        <!-- MOMENTS SECTION (DOKUMENTASI KELAS) -->
        <section id="moments" style="margin-bottom: 40px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div>
                    <span style="color: var(--primary, #6366f1); font-size: 12px; font-weight: bold;">MEMORIES</span>
                    <h2>Class Moments</h2>
                    <p style="color: #888; font-size: 14px; margin: 5px 0 0 0;">Simpan dokumentasi kegiatan kelas.</p>
                </div>
            </div>

            <!-- Wadah Foto Momen yang bisa dilihat semua pengunjung -->
            <div id="momentsGrid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                <div style="background: rgba(255,255,255,0.05); border-radius: 12px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); padding: 10px;">
                    <div style="width: 100%; height: 180px; background: rgba(255,255,255,0.05); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #888; margin-bottom: 10px;">
                        Foto Kegiatan XI IPS 1
                    </div>
                    <p style="color: white; font-weight: 500; font-size: 14px; margin: 0;">Kumpul Bersama Kelas</p>
                </div>
            </div>
        </section>

        <!-- MUSIC SECTION -->
        <section id="spotify" style="margin-bottom: 40px;">
            <div style="margin-bottom: 20px;">
                <span style="color: var(--primary, #6366f1); font-size: 12px; font-weight: bold;">MUSIC</span>
                <h2>Class Music</h2>
                <p style="color: #888; font-size: 14px; margin: 5px 0 0 0;">Temukan musik favorit untuk menemani belajar.</p>
            </div>
            <div style="background: rgba(255,255,255,0.03); padding: 20px; border-radius: 12px; display: flex; align-items: center; gap: 20px;">
                <div style="font-size: 32px;">♪</div>
                <div>
                    <h3 style="margin: 0 0 5px 0;">Spotify Music</h3>
                    <p style="color: #888; font-size: 14px; margin: 0;">Hubungkan Spotify API untuk menggunakan pencarian musik.</p>
                </div>
            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <footer>
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
            <div>
                <strong style="font-size: 16px;">XI IPS 1</strong>
                <p style="color: #888; font-size: 14px; margin: 5px 0 0 0;">Class Portal</p>
            </div>
            <div style="color: #888; font-size: 14px;">
                Dibuat oleh <strong>Aldiansyah</strong>
            </div>
        </div>
    </footer>

</body>

</html>
