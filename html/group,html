<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Spin Kelompok | XI IPS 1</title>

    <meta name="description"
          content="Sistem spin pembagian kelompok XI IPS 1">

    <link rel="stylesheet" href="css/group.css">
</head>

<body>

    <!-- BACKGROUND -->
    <div class="bg-orb orb-1"></div>
    <div class="bg-orb orb-2"></div>
    <div class="grid-bg"></div>

    <!-- NAVBAR -->
    <header class="navbar">

        <a href="index.html" class="brand">
            <span class="brand-icon">XI</span>

            <div>
                <strong>XI IPS 1</strong>
                <small>GROUP SPIN</small>
            </div>
        </a>

        <a href="index.html" class="back-btn">
            ← Kembali
        </a>

    </header>


    <!-- MAIN -->
    <main class="container">

        <!-- HEADER -->
        <section class="hero">

            <div class="badge">
                GROUP RANDOMIZER
            </div>

            <h1>
                Spin Pembagian
                <span>Kelompok</span>
            </h1>

            <p>
                Putar roda untuk menentukan kelompok secara acak.
            </p>

        </section>


        <!-- SPIN AREA -->
        <section class="game-card">

            <div class="settings">

                <label for="groupCount">
                    Jumlah Kelompok
                </label>

                <div class="select-row">

                    <select id="groupCount">
                        <option value="2">2 Kelompok</option>
                        <option value="3">3 Kelompok</option>
                        <option value="4">4 Kelompok</option>
                        <option value="5">5 Kelompok</option>
                        <option value="6">6 Kelompok</option>
                        <option value="7">7 Kelompok</option>
                        <option value="8">8 Kelompok</option>
                    </select>

                    <button
                        id="resetBtn"
                        class="secondary-btn">
                        Reset
                    </button>

                </div>

            </div>


            <!-- WHEEL -->
            <div class="wheel-area">

                <div class="pointer"></div>

                <div
                    class="wheel"
                    id="wheel">

                    <div class="wheel-center">
                        <span>SPIN</span>
                    </div>

                </div>

            </div>


            <!-- CURRENT NAME -->
            <div class="current-result">

                <span>HASIL SPIN</span>

                <strong id="currentName">
                    Siap?
                </strong>

            </div>


            <!-- BUTTON -->
            <button
                id="spinBtn"
                class="spin-btn">

                <span class="spin-icon">↻</span>
                PUTAR RODA

            </button>


            <!-- STATUS -->
            <div
                class="status"
                id="status">

                Klik "Putar Roda" untuk memulai.

            </div>

        </section>


        <!-- GROUP RESULT -->
        <section class="results-section">

            <div class="section-title">

                <div>
                    <span>HASIL PEMBAGIAN</span>

                    <h2>
                        Kelompok Kelas
                    </h2>
                </div>

                <button
                    id="shuffleBtn"
                    class="shuffle-btn">

                    Acak Ulang

                </button>

            </div>


            <div
                class="groups"
                id="groups">

                <div class="empty-state">

                    <div class="empty-icon">
                        +
                    </div>

                    <h3>
                        Belum ada pembagian
                    </h3>

                    <p>
                        Putar roda atau tekan Acak Ulang
                        untuk membuat kelompok.
                    </p>

                </div>

            </div>

        </section>


        <!-- FOOTER -->
        <footer>

            <strong>XI IPS 1</strong>

            <span>
                Group Randomizer
            </span>

        </footer>

    </main>


    <script src="js/group.js"></script>

</body>
</html>
