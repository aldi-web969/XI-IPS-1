const spinButton =
    document.getElementById("spinButton");

const result =
    document.getElementById("result");

const resultInfo =
    document.getElementById("resultInfo");


spinButton.addEventListener("click", () => {

    spinButton.disabled = true;

    let count = 0;

    const animation =
        setInterval(() => {

            const random =
                students[
                    Math.floor(
                        Math.random() *
                        students.length
                    )
                ];

            result.textContent = random;

            count++;

            if (count >= 25) {

                clearInterval(animation);

                const winner =
                    students[
                        Math.floor(
                            Math.random() *
                            students.length
                        )
                    ];

                result.textContent =
                    winner;

                resultInfo.textContent =
                    "Siswa terpilih secara acak.";

                spinButton.disabled = false;

            }

        }, 80);

});
