const spinButton = document.getElementById('spinButton');
const resultElement = document.getElementById('result');
const resultInfoElement = document.getElementById('resultInfo');

let isSpinning = false;

spinButton.addEventListener('click', function() {
    if (isSpinning) return; // Mencegah klik ganda saat sedang berputar
    
    isSpinning = true;
    spinButton.disabled = true;
    spinButton.style.opacity = '0.6';
    spinButton.textContent = 'MEMUTAR...';
    
    resultInfoElement.textContent = 'Menentukan siswa secara acak...';
    
    let counter = 0;
    const totalFlips = 30; // Jumlah pergantian nama sebelum berhenti
    const intervalTime = 70; // Kecepatan pergantian (semakin kecil semakin cepat)
    
    const spinInterval = setInterval(() => {
        // Tampilkan nama acak untuk efek animasi berputar
        const randomIndex = Math.floor(Math.random() * students.length);
        resultElement.textContent = students[randomIndex];
        resultElement.style.transform = `scale(${1 + (Math.random() * 0.15)})`;
        
        counter++;
        
        // Ketika mencapai batas perputaran, hentikan dan tentukan hasil akhir
        if (counter >= totalFlips) {
            clearInterval(spinInterval);
            
            // Pilih hasil akhir yang benar-benar acak
            const finalIndex = Math.floor(Math.random() * students.length);
            const winner = students[finalIndex];
            
            // Tampilkan hasil akhir
            resultElement.textContent = winner;
            resultElement.style.transform = 'scale(1.15)';
            setTimeout(() => {
                resultElement.style.transform = 'scale(1)';
            }, 250);
            
            resultInfoElement.innerHTML = `Terpilih: <strong style="color: var(--primary, #6366f1);">${winner}</strong> 🎉`;
            
            // Kembalikan tombol ke kondisi semula
            spinButton.disabled = false;
            spinButton.style.opacity = '1';
            spinButton.textContent = 'SPIN LAGI';
            isSpinning = false;
        }
    }, intervalTime);
});
